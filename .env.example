# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Public origin of the site (canonical URLs, links in e-mails, P24 return URL)
NEXT_PUBLIC_SITE_URL=https://bottegadakris.pl

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=siegeventure_bottegadakris
DB_USER=
DB_PASSWORD=

# SMTP (outgoing mail). MOCK_SMTP=true sends to a local catcher on localhost:1025 instead.
SMTP_HOST=smtp-siegeventure.alwaysdata.net
SMTP_PORT=587
SMTP_USER=biuro@bottegadakris.pl
SMTP_PASSWORD=
MAIL_FROM="Bottega da Kris" <biuro@bottegadakris.pl>
MAIL_OFFICE=biuro@bottegadakris.pl
MOCK_SMTP=false

# Przelewy24. MOCK_PAYMENT=true marks vouchers as paid without calling P24 (local development only).
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_API_URL=https://secure.przelewy24.pl
MOCK_PAYMENT=false

# next-auth (admin panel /olimp). Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://bottegadakris.pl

# Where uploaded blog/gallery files are stored (defaults to ./uploads)
UPLOAD_DIR=
